# Copy this file to .env.local and adjust it. Never commit .env.local.
# Every variable is described in doc/ARCHITECTURE.md, section 10.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_MODE=mock

# Needed only when NEXT_PUBLIC_BACKEND_MODE=supabase (from P3).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
