{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "bpm": {
      "type": "integer",
      "minimum": 60,
      "maximum": 200,
      "description": "Nhịp chung của các hiệu ứng trên trang (nhịp mỗi phút). Mặc định 120."
    },
    "trailerId": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        }
      ],
      "description": "ID video YouTube của trailer: 11 ký tự sau \"v=\" trong link. Để trống thì nút \"Xem trailer\" bị ẩn."
    },
    "copyrightHolder": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ],
      "description": "Tên chủ sở hữu bản quyền ở dòng cuối trang. null nghĩa là chưa quyết định."
    },
    "privacyContactEmail": {
      "anyOf": [
        {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Email nhận câu hỏi và yêu cầu xoá dữ liệu, hiện trên trang quyền riêng tư. null nghĩa là chưa có."
    },
    "logo": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^\\/images\\/[a-z0-9/_-]+\\.(webp|png|jpg|jpeg|svg|avif)$",
          "description": "Đường dẫn ảnh tính từ thư mục public/, ví dụ /images/hero/hero-desktop.webp. Đặt file đúng chỗ này là ảnh thay cho khung giữ chỗ."
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Chiều rộng ảnh (px). Khung giữ chỗ dùng tỉ lệ rộng/cao này."
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Chiều cao ảnh (px)."
        },
        "alt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*$",
          "description": "Khoá trong content/text/*.json chứa mô tả ảnh cho người dùng trình đọc màn hình, ví dụ hero.visualAlt."
        }
      },
      "required": [
        "src",
        "width",
        "height",
        "alt"
      ],
      "additionalProperties": false,
      "description": "Logo. Khi chưa có file, trang dùng logo chữ \"PROMUSE\". Kích thước ở đây là tạm, sửa theo logo thật."
    },
    "social": {
      "type": "object",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "Link trang X của Promuse. Để trống thì không hiện."
        },
        "facebook": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "Link trang Facebook của Promuse. Để trống thì không hiện."
        },
        "youtube": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "Link kênh YouTube của Promuse. Để trống thì không hiện."
        },
        "tiktok": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "Link TikTok của Promuse. Để trống thì không hiện."
        },
        "discord": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "Link mời vào Discord của Promuse. Để trống thì không hiện."
        }
      },
      "required": [
        "x",
        "facebook",
        "youtube",
        "tiktok",
        "discord"
      ],
      "additionalProperties": false,
      "description": "Link mạng xã hội ở cuối trang."
    },
    "stores": {
      "type": "object",
      "properties": {
        "googlePlay": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "format": "uri"
            }
          ],
          "description": "Link Google Play. Để trống thì trang hiện dòng chữ \"Sắp ra mắt trên Google Play\" thay cho nút."
        }
      },
      "required": [
        "googlePlay"
      ],
      "additionalProperties": false,
      "description": "Link cửa hàng ứng dụng."
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "android",
              "ios"
            ],
            "description": "Nền tảng."
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "coming-soon",
              "planned"
            ],
            "description": "available: đã phát hành; coming-soon: sắp ra mắt; planned: dự định, không hiện trên trang."
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      },
      "description": "Các nền tảng và trạng thái của từng nền tảng."
    },
    "shareHashtag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "description": "Hashtag gắn vào khi chia sẻ, không kèm dấu #."
    }
  },
  "required": [
    "bpm",
    "trailerId",
    "copyrightHolder",
    "privacyContactEmail",
    "logo",
    "social",
    "stores",
    "platforms",
    "shareHashtag"
  ],
  "additionalProperties": false
}
