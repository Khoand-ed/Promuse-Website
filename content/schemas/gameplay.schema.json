{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tabs": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "g1",
              "g2",
              "g3",
              "g4"
            ],
            "description": "Khoá của tab trong content/text (gameplay.tabs.<khoá>)."
          },
          "slides": {
            "minItems": 3,
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string",
                  "pattern": "^\\/images\\/[a-z0-9/_-]+\\.(webp|png|jpg|jpeg|svg|avif)$",
                  "description": "Đường dẫn ảnh tính từ thư mục public/, ví dụ /images/hero/hero-desktop.webp. Đặt file đúng chỗ này là ảnh thay cho khung giữ chỗ."
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Chiều rộng ảnh (px). Khung giữ chỗ dùng tỉ lệ rộng/cao này."
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Chiều cao ảnh (px)."
                },
                "alt": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*$",
                  "description": "Khoá trong content/text/*.json chứa mô tả ảnh cho người dùng trình đọc màn hình, ví dụ hero.visualAlt."
                }
              },
              "required": [
                "src",
                "width",
                "height",
                "alt"
              ],
              "additionalProperties": false,
              "description": "Ảnh trong slider của tab, 1280 × 720 (16:9)."
            },
            "description": "Ảnh của slider trong tab, theo thứ tự."
          }
        },
        "required": [
          "key",
          "slides"
        ],
        "additionalProperties": false
      },
      "description": "Bốn tab của modal Gameplay, theo thứ tự hiển thị."
    },
    "gacha": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "string",
          "enum": [
            "g1",
            "g2",
            "g3",
            "g4"
          ],
          "description": "Tab hiện dòng tỉ lệ gacha."
        },
        "rates": {
          "type": "object",
          "properties": {
            "fiveStar": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Tỉ lệ ra nhân vật 5★ (%)."
            },
            "fourStar": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Tỉ lệ ra nhân vật 4★ (%)."
            },
            "threeStar": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Tỉ lệ ra nhân vật 3★ (%)."
            }
          },
          "required": [
            "fiveStar",
            "fourStar",
            "threeStar"
          ],
          "additionalProperties": false,
          "description": "Tỉ lệ gacha, lấy từ doc/GAME_FACTS.md mục 4. Tổng phải bằng 100."
        }
      },
      "required": [
        "tab",
        "rates"
      ],
      "additionalProperties": false,
      "description": "Dữ liệu gacha hiển thị trong modal Gameplay."
    }
  },
  "required": [
    "tabs",
    "gacha"
  ],
  "additionalProperties": false
}
