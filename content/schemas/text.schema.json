{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "\\S",
          "description": "Tiêu đề trang trên tab trình duyệt và trong kết quả tìm kiếm."
        },
        "description": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mô tả ngắn của trang cho kết quả tìm kiếm và khi chia sẻ link. Khoảng 120–160 ký tự."
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "common": {
      "type": "object",
      "properties": {
        "brand": {
          "type": "string",
          "pattern": "\\S",
          "description": "Tên game hiển thị trên trang. Giữ là Promuse."
        },
        "logoAlt": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mô tả logo cho người dùng trình đọc màn hình. Giữ là Promuse."
        },
        "skipToContent": {
          "type": "string",
          "pattern": "\\S",
          "description": "Link ẩn cho người dùng bàn phím, hiện ra khi bấm Tab lần đầu."
        },
        "backToTop": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn nút quay lên đầu trang."
        },
        "openMenu": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn nút mở menu trên điện thoại."
        },
        "closeMenu": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn nút đóng menu trên điện thoại."
        },
        "mainNav": {
          "type": "string",
          "pattern": "\\S",
          "description": "Tên vùng điều hướng chính, dành cho trình đọc màn hình."
        },
        "language": {
          "type": "string",
          "pattern": "\\S",
          "description": "Tên nhóm nút chọn ngôn ngữ, dành cho trình đọc màn hình."
        },
        "languageNames": {
          "type": "object",
          "properties": {
            "vi": {
              "type": "string",
              "pattern": "\\S",
              "description": "Chữ trên nút chọn tiếng Việt."
            },
            "en": {
              "type": "string",
              "pattern": "\\S",
              "description": "Chữ trên nút chọn tiếng Anh."
            }
          },
          "required": [
            "vi",
            "en"
          ],
          "additionalProperties": false
        },
        "close": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn chung của nút đóng hộp thoại."
        },
        "imagePlaceholder": {
          "type": "string",
          "pattern": "\\S",
          "description": "Chữ trên khung giữ chỗ khi chưa có ảnh. Giữ nguyên {name}, {width} và {height}."
        }
      },
      "required": [
        "brand",
        "logoAlt",
        "skipToContent",
        "backToTop",
        "openMenu",
        "closeMenu",
        "mainNav",
        "language",
        "languageNames",
        "close",
        "imagePlaceholder"
      ],
      "additionalProperties": false
    },
    "nav": {
      "type": "object",
      "properties": {
        "story": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mục \"Giới thiệu\" trên thanh điều hướng."
        },
        "features": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mục \"Tính năng\" trên thanh điều hướng."
        },
        "gameplay": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mục \"Gameplay\" trên thanh điều hướng."
        },
        "characters": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mục \"Nhân vật\" trên thanh điều hướng."
        },
        "reward": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nút \"Nhận quà\" nổi bật trên thanh điều hướng."
        }
      },
      "required": [
        "story",
        "features",
        "gameplay",
        "characters",
        "reward"
      ],
      "additionalProperties": false
    },
    "intro": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string",
          "pattern": "\\S",
          "description": "Dòng mở đầu thứ 1 (trong 3 dòng hiện theo nhịp trước khi vào trang). Khoảng 30 ký tự."
        },
        "line2": {
          "type": "string",
          "pattern": "\\S",
          "description": "Dòng mở đầu thứ 2. Khoảng 30 ký tự."
        },
        "line3": {
          "type": "string",
          "pattern": "\\S",
          "description": "Dòng mở đầu thứ 3. Khoảng 30 ký tự."
        },
        "skip": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn nút bỏ qua màn mở đầu."
        }
      },
      "required": [
        "line1",
        "line2",
        "line3",
        "skip"
      ],
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "pattern": "\\S",
          "description": "Dòng trạng thái ở màn đầu tiên, ví dụ \"Sắp ra mắt trên Android\". Không nhắc iOS."
        },
        "cta": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nút chính ở màn đầu tiên, cuộn tới khối nhận quà."
        },
        "trailer": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nút mở trailer. Nút tự ẩn khi chưa có ID trailer."
        },
        "scroll": {
          "type": "string",
          "pattern": "\\S",
          "description": "Chữ nhỏ gợi ý cuộn xuống."
        },
        "visualAlt": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mô tả ảnh key visual cho người dùng trình đọc màn hình."
        }
      },
      "required": [
        "status",
        "cta",
        "trailer",
        "scroll",
        "visualAlt"
      ],
      "additionalProperties": false
    },
    "reward": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "\\S",
          "description": "Tiêu đề khối nhận quà đăng ký sớm."
        },
        "desc": {
          "type": "string",
          "pattern": "\\S",
          "description": "Một dòng mô tả phần quà: số lượng và tên tiền tệ. Tên tiền tệ chưa chốt; số lượng phải khớp với chiến dịch trong cơ sở dữ liệu."
        },
        "artAlt": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mô tả ảnh phần quà cho người dùng trình đọc màn hình."
        },
        "privacy": {
          "type": "string",
          "pattern": "\\S",
          "description": "Dòng nhỏ dưới nút đăng ký, nói email dùng để làm gì."
        },
        "privacyLink": {
          "type": "string",
          "pattern": "\\S",
          "description": "Chữ của link tới trang quyền riêng tư."
        },
        "notYou": {
          "type": "string",
          "pattern": "\\S",
          "description": "Câu hỏi hiện khi đã đăng nhập, trước link đăng xuất."
        },
        "signOut": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn link đăng xuất."
        },
        "states": {
          "type": "object",
          "properties": {
            "signedOut": {
              "type": "string",
              "pattern": "\\S",
              "description": "Nút khi chưa đăng nhập."
            },
            "redirecting": {
              "type": "string",
              "pattern": "\\S",
              "description": "Nút trong lúc chuyển sang trang đăng nhập Google."
            },
            "registering": {
              "type": "string",
              "pattern": "\\S",
              "description": "Nút trong lúc đang ghi nhận đăng ký."
            },
            "registered": {
              "type": "string",
              "pattern": "\\S",
              "description": "Thông báo đăng ký thành công; có thể dùng {email}. Không được hứa nhận quà trong game, vì game chưa có đăng nhập Google."
            },
            "alreadyRegistered": {
              "type": "string",
              "pattern": "\\S",
              "description": "Thông báo khi tài khoản đã đăng ký từ trước. Giữ nguyên {date}."
            },
            "signedInNotRegistered": {
              "type": "string",
              "pattern": "\\S",
              "description": "Nút khi đã đăng nhập nhưng chưa đăng ký."
            },
            "cancelled": {
              "type": "string",
              "pattern": "\\S",
              "description": "Thông báo khi người dùng huỷ đăng nhập Google."
            },
            "error": {
              "type": "string",
              "pattern": "\\S",
              "description": "Thông báo khi có lỗi, kèm lời mời thử lại."
            },
            "closed": {
              "type": "string",
              "pattern": "\\S",
              "description": "Thông báo khi chương trình đăng ký sớm đã kết thúc."
            },
            "notOpen": {
              "type": "string",
              "pattern": "\\S",
              "description": "Thông báo khi chưa mở đăng ký (website thật dùng trạng thái này cho tới khi có đăng ký thật)."
            }
          },
          "required": [
            "signedOut",
            "redirecting",
            "registering",
            "registered",
            "alreadyRegistered",
            "signedInNotRegistered",
            "cancelled",
            "error",
            "closed",
            "notOpen"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "desc",
        "artAlt",
        "privacy",
        "privacyLink",
        "notYou",
        "signOut",
        "states"
      ],
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "\\S",
          "description": "Tiêu đề phần giới thiệu thế giới game."
        },
        "p1": {
          "type": "string",
          "pattern": "\\S",
          "description": "Đoạn giới thiệu thứ 1, 2–3 câu. Nói về thế giới và nhân vật, không nói về âm nhạc."
        },
        "p2": {
          "type": "string",
          "pattern": "\\S",
          "description": "Đoạn giới thiệu thứ 2, 2–3 câu."
        },
        "p3": {
          "type": "string",
          "pattern": "\\S",
          "description": "Đoạn giới thiệu thứ 3, 2–3 câu."
        },
        "band1": {
          "type": "string",
          "pattern": "\\S",
          "description": "Khẩu hiệu thứ 1, chữ rất lớn chạy ngang màn hình. Vài chữ."
        },
        "band2": {
          "type": "string",
          "pattern": "\\S",
          "description": "Khẩu hiệu thứ 2. Vài chữ."
        },
        "band3": {
          "type": "string",
          "pattern": "\\S",
          "description": "Khẩu hiệu thứ 3. Vài chữ."
        },
        "imageAlt": {
          "type": "string",
          "pattern": "\\S",
          "description": "Mô tả ảnh của phần giới thiệu."
        }
      },
      "required": [
        "title",
        "p1",
        "p2",
        "p3",
        "band1",
        "band2",
        "band3",
        "imageAlt"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "\\S",
          "description": "Tiêu đề phần Tính năng."
        },
        "summary": {
          "type": "string",
          "pattern": "\\S",
          "description": "Hai câu tóm tắt dưới tiêu đề phần Tính năng."
        },
        "seeDetails": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nút mở modal chi tiết tính năng."
        },
        "number": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn nhỏ trên mỗi tab, ví dụ \"TÍNH NĂNG #1\". Giữ nguyên {n}."
        },
        "items": {
          "type": "object",
          "properties": {
            "f1": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Tên tính năng 1: hiện trên thẻ ở trang chính và trên tab 1 của modal Tính năng. Khoảng 30 ký tự."
                },
                "line": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Một dòng mô tả dưới tên thẻ tính năng 1 trên trang chính. Khoảng 80 ký tự."
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Một hoặc hai câu giải thích tính năng 1, hiện trong tab 1 của modal. Viết đơn giản, chỉ dùng dữ kiện trong doc/GAME_FACTS.md."
                },
                "image1Alt": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Mô tả ảnh thứ nhất của tính năng 1 cho người dùng trình đọc màn hình."
                },
                "image2Alt": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Mô tả ảnh thứ hai của tính năng 1 cho người dùng trình đọc màn hình."
                }
              },
              "required": [
                "title",
                "line",
                "text",
                "image1Alt",
                "image2Alt"
              ],
              "additionalProperties": false
            },
            "f2": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Tên tính năng 2: hiện trên thẻ ở trang chính và trên tab 2 của modal Tính năng. Khoảng 30 ký tự."
                },
                "line": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Một dòng mô tả dưới tên thẻ tính năng 2 trên trang chính. Khoảng 80 ký tự."
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Một hoặc hai câu giải thích tính năng 2, hiện trong tab 2 của modal. Viết đơn giản, chỉ dùng dữ kiện trong doc/GAME_FACTS.md."
                },
                "image1Alt": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Mô tả ảnh thứ nhất của tính năng 2 cho người dùng trình đọc màn hình."
                },
                "image2Alt": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Mô tả ảnh thứ hai của tính năng 2 cho người dùng trình đọc màn hình."
                }
              },
              "required": [
                "title",
                "line",
                "text",
                "image1Alt",
                "image2Alt"
              ],
              "additionalProperties": false
            },
            "f3": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Tên tính năng 3: hiện trên thẻ ở trang chính và trên tab 3 của modal Tính năng. Khoảng 30 ký tự."
                },
                "line": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Một dòng mô tả dưới tên thẻ tính năng 3 trên trang chính. Khoảng 80 ký tự."
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Một hoặc hai câu giải thích tính năng 3, hiện trong tab 3 của modal. Viết đơn giản, chỉ dùng dữ kiện trong doc/GAME_FACTS.md."
                },
                "image1Alt": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Mô tả ảnh thứ nhất của tính năng 3 cho người dùng trình đọc màn hình."
                },
                "image2Alt": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Mô tả ảnh thứ hai của tính năng 3 cho người dùng trình đọc màn hình."
                }
              },
              "required": [
                "title",
                "line",
                "text",
                "image1Alt",
                "image2Alt"
              ],
              "additionalProperties": false
            },
            "f4": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Tên tính năng 4: hiện trên thẻ ở trang chính và trên tab 4 của modal Tính năng. Khoảng 30 ký tự."
                },
                "line": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Một dòng mô tả dưới tên thẻ tính năng 4 trên trang chính. Khoảng 80 ký tự."
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Một hoặc hai câu giải thích tính năng 4, hiện trong tab 4 của modal. Viết đơn giản, chỉ dùng dữ kiện trong doc/GAME_FACTS.md."
                },
                "image1Alt": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Mô tả ảnh thứ nhất của tính năng 4 cho người dùng trình đọc màn hình."
                },
                "image2Alt": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Mô tả ảnh thứ hai của tính năng 4 cho người dùng trình đọc màn hình."
                }
              },
              "required": [
                "title",
                "line",
                "text",
                "image1Alt",
                "image2Alt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "f1",
            "f2",
            "f3",
            "f4"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "summary",
        "seeDetails",
        "number",
        "items"
      ],
      "additionalProperties": false
    },
    "gameplay": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "\\S",
          "description": "Tiêu đề phần Gameplay."
        },
        "summary": {
          "type": "string",
          "pattern": "\\S",
          "description": "Hai câu tóm tắt cách chơi dưới tiêu đề phần Gameplay."
        },
        "details": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nút mở modal chi tiết gameplay."
        },
        "rates": {
          "type": "string",
          "pattern": "\\S",
          "description": "Dòng tỉ lệ gacha. Giữ nguyên {fiveStar}, {fourStar}, {threeStar}: các con số lấy từ dữ liệu."
        },
        "previous": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn nút ảnh trước trong slider."
        },
        "next": {
          "type": "string",
          "pattern": "\\S",
          "description": "Nhãn nút ảnh sau trong slider."
        },
        "position": {
          "type": "string",
          "pattern": "\\S",
          "description": "Câu đọc cho trình đọc màn hình khi chuyển ảnh. Giữ nguyên {current} và {total}."
        },
        "tabs": {
          "type": "object",
          "properties": {
            "g1": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Tiêu đề tab 1 trong modal Gameplay. Khoảng 30 ký tự."
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Đoạn giải thích ngắn cho tab 1, viết đơn giản và dễ hiểu, không đi vào chi tiết luật chơi. Chỉ dùng dữ kiện trong doc/GAME_FACTS.md."
                },
                "slides": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "Mô tả từng ảnh trong slider của tab 1. Mỗi ảnh khai báo trong content/data/gameplay.json trỏ tới một khoá ở đây."
                  },
                  "description": "Mô tả từng ảnh trong slider của tab 1. Mỗi ảnh khai báo trong content/data/gameplay.json trỏ tới một khoá ở đây."
                }
              },
              "required": [
                "title",
                "text",
                "slides"
              ],
              "additionalProperties": false
            },
            "g2": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Tiêu đề tab 2 trong modal Gameplay. Khoảng 30 ký tự."
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Đoạn giải thích ngắn cho tab 2, viết đơn giản và dễ hiểu, không đi vào chi tiết luật chơi. Chỉ dùng dữ kiện trong doc/GAME_FACTS.md."
                },
