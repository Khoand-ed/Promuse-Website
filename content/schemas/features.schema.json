{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cover": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^\\/images\\/[a-z0-9/_-]+\\.(webp|png|jpg|jpeg|svg|avif)$",
          "description": "Đường dẫn ảnh tính từ thư mục public/, ví dụ /images/hero/hero-desktop.webp. Đặt file đúng chỗ này là ảnh thay cho khung giữ chỗ."
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Chiều rộng ảnh (px). Khung giữ chỗ dùng tỉ lệ rộng/cao này."
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Chiều cao ảnh (px)."
        },
        "alt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*$",
          "description": "Khoá trong content/text/*.json chứa mô tả ảnh cho người dùng trình đọc màn hình, ví dụ hero.visualAlt."
        }
      },
      "required": [
        "src",
        "width",
        "height",
        "alt"
      ],
      "additionalProperties": false,
      "description": "Ảnh bìa của phần Tính năng trên trang chính, 16:9 (1280 × 720)."
    },
    "items": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "f1",
              "f2",
              "f3",
              "f4"
            ],
            "description": "Khoá của tính năng trong content/text (features.items.<khoá>)."
          },
          "images": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string",
                  "pattern": "^\\/images\\/[a-z0-9/_-]+\\.(webp|png|jpg|jpeg|svg|avif)$",
                  "description": "Đường dẫn ảnh tính từ thư mục public/, ví dụ /images/hero/hero-desktop.webp. Đặt file đúng chỗ này là ảnh thay cho khung giữ chỗ."
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Chiều rộng ảnh (px). Khung giữ chỗ dùng tỉ lệ rộng/cao này."
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Chiều cao ảnh (px)."
                },
                "alt": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*$",
                  "description": "Khoá trong content/text/*.json chứa mô tả ảnh cho người dùng trình đọc màn hình, ví dụ hero.visualAlt."
                }
              },
              "required": [
                "src",
                "width",
                "height",
                "alt"
              ],
              "additionalProperties": false,
              "description": "Ảnh minh hoạ tính năng, 1280 × 720."
            },
            "description": "Hai ảnh của tính năng, hiện trong tab của modal Tính năng."
          }
        },
        "required": [
          "key",
          "images"
        ],
        "additionalProperties": false
      },
      "description": "Bốn tính năng, theo thứ tự hiển thị."
    }
  },
  "required": [
    "cover",
    "items"
  ],
  "additionalProperties": false
}
